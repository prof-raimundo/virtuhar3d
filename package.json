{
  "name": "virtuhar3d-monorepo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "rules",
    "content"
  ],
  "scripts": {
    "dev": "tsx server/src/devPreview.ts",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run typecheck && npm run lint:eslint",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p rules/tsconfig.json --noEmit && tsc -p content/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:traceability": "tsx scripts/traceability-report.ts",
    "test:watch": "vitest",
    "validate:content": "tsx content/src/validate.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "ci": "npm run format:check && npm run lint && npm run validate:content && npm run validate:assets && npm run test:traceability && npm run test:coverage"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.2",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "fastify": "^5.12.8",
    "lucide-react": "^0.546.0",
    "meshoptimizer": "^1.3.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "prettier": "^3.10.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3"
  }
}
